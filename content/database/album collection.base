filters:
  and:
    - file.inFolder("album collection")
views:
  - type: table
    name: Table
    order:
      - file.name
      - artist
      - cover_image
      - genres
      - link
      - listened_on
      - listened_to
      - rating
      - release_date
    sort:
      - property: cover_image
        direction: DESC
      - property: listened_on
        direction: DESC
